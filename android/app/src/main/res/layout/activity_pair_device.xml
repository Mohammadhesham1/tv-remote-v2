<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📺"
        android:textSize="72sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ربط التليفزيون"
        android:textColor="@color/text"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvPairStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ابحث عن تليفزيون أو أدخل الـ IP"
        android:textColor="@color/sub"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <ProgressBar
        android:id="@+id/pairProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnScanDevices"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="بحث تلقائي عن الأجهزة"
        android:textColor="@color/text"
        android:backgroundTint="@color/surface"
        android:textSize="15sp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnStartPairing"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="بدء الربط مع التليفزيون"
        android:textColor="@color/text"
        android:backgroundTint="@color/accent"
        android:textSize="15sp"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/etPairCode"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:hint="أدخل الكود (مثال: A1B2C3)"
        android:inputType="textCapCharacters"
        android:gravity="center"
        android:background="@color/surface"
        android:textColor="@color/text"
        android:textColorHint="@color/dim"
        android:textSize="24sp"
        android:letterSpacing="0.3"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnSubmitCode"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="تأكيد الكود"
        android:textColor="@color/text"
        android:backgroundTint="@color/green"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="تخطي في الوقت الحالي"
        android:textColor="@color/dim"
        android:textSize="13sp"
        android:padding="8dp"/>

</LinearLayout>
